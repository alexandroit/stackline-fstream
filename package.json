    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint fstream.js index.mjs lib scripts test examples",
    "test:upstream": "tape test/upstream.test.js",
    "test:differential": "node test/differential.js",
    "test:regressions": "tape test/regressions.test.js",
    "test:malformed": "tape test/malformed.test.js",
    "test:stress": "tape test/stress.test.js",
    "test:esm": "node test/esm.mjs",
    "test:types": "node node_modules/typescript-3-9/bin/tsc -p test/types/tsconfig.legacy.json && node node_modules/typescript/bin/tsc -p test/types/tsconfig.commonjs.json && node node_modules/typescript/bin/tsc -p test/types/tsconfig.modern.json",
    "test:runtime": "node test/runtime-compat.js",
    "test": "npm run test:upstream && npm run test:differential && npm run test:regressions && npm run test:malformed && npm run test:stress && npm run test:esm && npm run test:types && npm run test:runtime",
    "test:coverage": "c8 --all --include=fstream.js --include=lib/*.js --check-coverage --lines 85 --functions 85 --branches 75 tape test/upstream.test.js test/regressions.test.js test/malformed.test.js test/stress.test.js",
    "test:smoke": "node scripts/smoke-install.mjs",
    "test:closure": "node scripts/check-production-closure.mjs",
    "check:package": "publint && attw --pack .",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "pack:check": "npm pack --dry-run",
    "artifact:prepare": "node scripts/create-artifact.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "verify": "npm run clean && npm run lint && npm run build && npm test && npm run test:coverage && npm run test:smoke && npm run test:closure && npm run check:package && npm run check:release-metadata && npm run pack:check && npm run check:licenses && npm run audit:dependencies && npm run audit:all && npm run audit:signatures",
    "prepack": "npm run build"
